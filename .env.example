APP_NAME="Kathford Process Portal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://process.kathford.edu.np
APP_TIMEZONE=Asia/Kathmandu

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kathford_process
DB_USERNAME=kathford_app
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# College SMTP — use Google Workspace SMTP
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@kathford.edu.np
MAIL_PASSWORD=GOOGLE_APP_PASSWORD_HERE
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@process.kathford.edu.np
MAIL_FROM_NAME="Kathford Process Portal"

# Google OAuth 2.0 (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://process.kathford.edu.np/auth/google/callback

# Restrict login to @kathford.edu.np domain ONLY
ALLOWED_EMAIL_DOMAIN=kathford.edu.np

# 2FA
TWO_FACTOR_REQUIRED=true
GOOGLE2FA_WINDOW=1

# File uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,docx,doc,jpg,jpeg,png

# RFQ vendor link expiry (days)
RFQ_LINK_EXPIRY_DAYS=7
